{
  "servers": [
    {
      "server_name": "localhost",
      "host": "127.0.0.1",
      "ports": [8081, 8082],
      "error_pages": {
        "404": "/errors/404.html",
        "400": "/errors/400.html",
        "403": "/errors/403.html",
        "405": "/errors/405.html",
        "413": "/errors/413.html",
        "500": "/errors/500.html"
      },
      "client_max_body_size": 1048576,
      "routes": [
        {
          "path": "/",
          "methods": ["GET", "POST"],
          "root": "./www",
          "index": "index.html",
          "autoindex": true
        },
        {
          "path": "/upload",
          "methods": ["POST"],
          "root": "/var/uploads"
        },
        {
          "path": "/cgi-bin",
          "methods": ["GET", "POST"],
          "root": "./cgi-bin",
          "cgi_map": {
            ".py": "python3"
          }
        },
        {
          "path": "/site",
          "methods": ["GET"],
          "root": "./www/site",
          "index": "index.html",
          "autoindex": true
        }
      ]
    }
  ]
}